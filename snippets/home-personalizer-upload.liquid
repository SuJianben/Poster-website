{% assign home_artwork_input_id = 'HomeArtwork-' | append: section.id %}

<div
  class="home-personalizer__upload"
  data-home-personalizer-upload
  data-max-file-bytes="20971520"
  data-max-image-pixels="20000000"
>
  <p class="home-personalizer__upload-heading">{{ section.settings.upload_heading }}</p>
  <div class="home-personalizer__dropzone" data-home-personalizer-dropzone>
    <svg class="home-personalizer__upload-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14.5v3.25A2.25 2.25 0 0 0 7.25 20h9.5A2.25 2.25 0 0 0 19 17.75V14.5" />
    </svg>
    <div class="home-personalizer__upload-copy">
      <strong>Drag and drop your image here</strong>
      <span>or</span>
    </div>
    <label class="home-personalizer__upload-button" for="{{ home_artwork_input_id }}">{{ section.settings.upload_button_label }}</label>
    <input
      class="home-personalizer__file-input"
      id="{{ home_artwork_input_id }}"
      type="file"
      accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
      data-home-personalizer-input
      aria-describedby="{{ home_artwork_input_id }}-help {{ home_artwork_input_id }}-status"
    >
  </div>
  <p class="home-personalizer__upload-help" id="{{ home_artwork_input_id }}-help">{{ section.settings.upload_help_text }}</p>
  <div class="home-personalizer__selection" data-home-personalizer-selection hidden>
    <span class="home-personalizer__file-name" data-home-personalizer-file-name></span>
    <button class="home-personalizer__remove" type="button" data-home-personalizer-remove>Remove</button>
  </div>
  <p class="home-personalizer__status" id="{{ home_artwork_input_id }}-status" data-home-personalizer-status role="status" aria-live="polite"></p>
</div>
