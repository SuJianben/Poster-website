<div class="ps-cropper" data-ps-cropper hidden>
  <div class="ps-cropper__backdrop" data-ps-cropper-cancel></div>
  <section class="ps-cropper__dialog" role="dialog" aria-modal="true" aria-labelledby="ps-cropper-heading-{{ section.id }}">
    <header class="ps-cropper__header">
      <div>
        <h2 id="ps-cropper-heading-{{ section.id }}">{{ section.settings.crop_heading }}</h2>
        <p>
          {% if section.settings.framing_render_mode == 'css' %}
            Choose a fixed ratio, or select Free crop to adjust the shape freely.
          {% else %}
            {{ section.settings.crop_help_text }}
          {% endif %}
        </p>
      </div>
      <button class="ps-cropper__close" type="button" data-ps-cropper-cancel aria-label="Close image cropper">×</button>
    </header>

    <div class="ps-cropper__workspace" data-ps-cropper-workspace>
      <canvas class="ps-cropper__canvas" data-ps-cropper-canvas></canvas>
    </div>

    <div class="ps-cropper__ratio-group{% if section.settings.framing_render_mode == 'css' %} ps-cropper__ratio-group--with-freeform{% endif %}" role="radiogroup" aria-label="Artwork ratio">
      <button class="ps-cropper__ratio is-selected" type="button" data-ps-cropper-ratio="landscape" role="radio" aria-checked="true">
        <span class="ps-cropper__ratio-shape ps-cropper__ratio-shape--landscape" aria-hidden="true"></span>
        <span>Landscape</span><small>1.414 : 1</small>
      </button>
      <button class="ps-cropper__ratio" type="button" data-ps-cropper-ratio="square" role="radio" aria-checked="false">
        <span class="ps-cropper__ratio-shape ps-cropper__ratio-shape--square" aria-hidden="true"></span>
        <span>Square</span><small>1 : 1</small>
      </button>
      <button class="ps-cropper__ratio" type="button" data-ps-cropper-ratio="portrait" role="radio" aria-checked="false">
        <span class="ps-cropper__ratio-shape ps-cropper__ratio-shape--portrait" aria-hidden="true"></span>
        <span>Portrait</span><small>1 : 1.414</small>
      </button>
      {% if section.settings.framing_render_mode == 'css' %}
        <button class="ps-cropper__ratio" type="button" data-ps-cropper-ratio="freeform" role="radio" aria-checked="false">
          <span class="ps-cropper__ratio-shape ps-cropper__ratio-shape--freeform" aria-hidden="true"></span>
          <span>Free crop</span><small>Any ratio</small>
        </button>
      {% endif %}
    </div>

    <p
      class="ps-cropper__instruction"
      data-ps-cropper-instruction
      data-fixed-text="Drag to reposition. Drag a corner to resize while keeping the selected ratio."
      data-freeform-text="Drag to reposition. Drag any corner to resize freely."
    >
      {% if section.settings.framing_render_mode == 'css' %}
        Drag to reposition. Drag a corner to resize while keeping the selected ratio.
      {% else %}
        Drag to reposition. Drag a corner to resize while keeping the selected ratio.
      {% endif %}
    </p>
    <footer class="ps-cropper__actions">
      <button class="ps-cropper__button ps-cropper__button--secondary" type="button" data-ps-cropper-cancel>{{ section.settings.crop_cancel_label }}</button>
      <button class="ps-cropper__button ps-cropper__button--primary" type="button" data-ps-cropper-confirm>{{ section.settings.crop_confirm_label }}</button>
    </footer>
  </section>
</div>
