{% case icon %}
  {% when 'quality' %}
    <svg class="ps-benefit-icon__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="2" y="3" width="16" height="13" rx="1"></rect>
      <path d="M2 12l3-3 3 3"></path>
      <path d="M6 10l3-3 5 5"></path>
      <circle cx="6" cy="7" r="1.2" fill="currentColor" stroke="none"></circle>
      <path d="M15.5 17l-1 4.5L17 20l2.5 1.5-1-4.5" fill="var(--ps-benefit-bg)" stroke="currentColor"></path>
      <circle cx="18" cy="14" r="4.5" fill="var(--ps-benefit-bg)"></circle>
      <polygon points="18,11.5 18.7,13 20.3,13.2 19,14.4 19.4,16 18,15.1 16.6,16 17,14.4 15.7,13.2 17.3,13" fill="currentColor" stroke="none"></polygon>
    </svg>
  {% when 'guarantee' %}
    <svg class="ps-benefit-icon__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      <path d="M9 12l2 2 4-4"></path>
    </svg>
  {% when 'shipping' %}
    <svg class="ps-benefit-icon__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M2 5h12v11H2z"></path>
      <path d="M14 8h4l3 4v4h-7z"></path>
      <path d="M16 10h2l1.5 2H16z"></path>
      <path d="M2 13h12"></path>
      <circle cx="6" cy="17.5" r="2"></circle>
      <circle cx="18" cy="17.5" r="2"></circle>
    </svg>
  {% when 'returns' %}
    <svg class="ps-benefit-icon__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3L6 6v6l6 3 6-3V6z"></path>
      <polyline points="6 6 12 9 18 6"></polyline>
      <line x1="12" y1="9" x2="12" y2="15"></line>
      <path d="M9 22l-3-3 3-3"></path>
      <path d="M6 19h8a3 3 0 0 0 3-3v-1"></path>
    </svg>
{% endcase %}
