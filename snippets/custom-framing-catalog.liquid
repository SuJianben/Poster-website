{%- liquid
  assign passepartout_product = section.settings.passepartout_product
  if passepartout_product == blank
    assign passepartout_product = all_products['system-passepartout-addon']
  endif
  assign frame_product = section.settings.frame_product
  if frame_product == blank
    assign frame_product = all_products['system-frame-addon']
  endif
-%}
<script type="application/json" data-ps-framing-catalog>
{
  "passepartout": {
    "productId": {{ passepartout_product.id | json }},
    "handle": {{ passepartout_product.handle | json }},
    "variants": [
      {%- for variant in passepartout_product.variants -%}
        {%- assign style_slug = variant.metafields.custom.framing_style_slug.value -%}
        {
          "id": {{ variant.id | json }},
          "style": {{ variant.option1 | json }},
          "styleSlug": {{ style_slug | json }},
          "size": {{ variant.option2 | json }},
          "fitsSize": {{ variant.metafields.custom.fits_size.value | json }},
          "price": {{ variant.price }},
          "formattedPrice": {{ variant.price | money | json }},
          "available": {{ variant.available | json }},
          "sku": {{ variant.sku | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  },
  "frame": {
    "productId": {{ frame_product.id | json }},
    "handle": {{ frame_product.handle | json }},
    "variants": [
      {%- for variant in frame_product.variants -%}
        {%- assign style_slug = variant.metafields.custom.framing_style_slug.value -%}
        {
          "id": {{ variant.id | json }},
          "style": {{ variant.option1 | json }},
          "styleSlug": {{ style_slug | json }},
          "size": {{ variant.option2 | json }},
          "fitsSize": {{ variant.metafields.custom.fits_size.value | json }},
          "price": {{ variant.price }},
          "formattedPrice": {{ variant.price | money | json }},
          "available": {{ variant.available | json }},
          "sku": {{ variant.sku | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
}
</script>
