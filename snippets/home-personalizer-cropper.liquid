<div class="ps-cropper" data-home-personalizer-cropper hidden>
  <div class="ps-cropper__backdrop" data-home-personalizer-crop-cancel></div>
  <section class="ps-cropper__dialog" role="dialog" aria-modal="true" aria-labelledby="home-cropper-heading-{{ section.id }}">
    <header class="ps-cropper__header">
      <div>
        <h2 id="home-cropper-heading-{{ section.id }}">{{ section.settings.crop_heading }}</h2>
        <p>{{ section.settings.crop_help_text }}</p>
      </div>
      <button class="ps-cropper__close" type="button" data-home-personalizer-crop-cancel aria-label="Close image cropper">×</button>
    </header>

    <div class="ps-cropper__workspace" data-home-personalizer-crop-workspace>
      <canvas class="ps-cropper__canvas" data-home-personalizer-crop-canvas></canvas>
    </div>

    <div class="ps-cropper__ratio-group" role="radiogroup" aria-label="Poster ratio">
      <button class="ps-cropper__ratio is-selected" type="button" data-home-personalizer-ratio="landscape" role="radio" aria-checked="true">
        <span class="ps-cropper__ratio-shape ps-cropper__ratio-shape--landscape" aria-hidden="true"></span>
        <span>Landscape</span><small>1.414 : 1</small>
      </button>
      <button class="ps-cropper__ratio" type="button" data-home-personalizer-ratio="square" role="radio" aria-checked="false">
        <span class="ps-cropper__ratio-shape ps-cropper__ratio-shape--square" aria-hidden="true"></span>
        <span>Square</span><small>1 : 1</small>
      </button>
      <button class="ps-cropper__ratio" type="button" data-home-personalizer-ratio="portrait" role="radio" aria-checked="false">
        <span class="ps-cropper__ratio-shape ps-cropper__ratio-shape--portrait" aria-hidden="true"></span>
        <span>Portrait</span><small>1 : 1.414</small>
      </button>
    </div>

    <p class="ps-cropper__instruction">Drag to reposition. Drag a corner to resize while keeping the selected ratio.</p>
    <footer class="ps-cropper__actions">
      <button class="ps-cropper__button ps-cropper__button--secondary" type="button" data-home-personalizer-crop-cancel>{{ section.settings.crop_cancel_label }}</button>
      <button class="ps-cropper__button ps-cropper__button--primary" type="button" data-home-personalizer-crop-confirm>{{ section.settings.crop_confirm_label }}</button>
    </footer>
  </section>
</div>

