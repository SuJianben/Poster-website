<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <!-- BEGIN Google Ads Tracking (PosterAndForm) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-18302569250"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'AW-18302569250');

  // Page-type events (fire before user interaction — for view/AddToCart/BeginCheckout diagnostics)
  (function(){
    var path = window.location.pathname;
    if (/^\/products\//.test(path)) {
      gtag('event', 'view_item', {send_to: 'AW-18302569250'});
    } else if (/^\/cart/.test(path)) {
      gtag('event', 'view_cart', {send_to: 'AW-18302569250'});
    } else if (/^\/checkouts?\//.test(path)) {
      gtag('event', 'begin_checkout', {send_to: 'AW-18302569250'});
    }
  })();

  // Add-to-cart: intercept clicks on any ATC button, plus fetch to /cart/add
  document.addEventListener('DOMContentLoaded', function(){
    // Click delegation (works for most themes: [name="add"], [data-add-to-cart], .btn--add-to-cart etc.)
    document.addEventListener('click', function(e){
      var t = e.target.closest('button[name="add"], button[data-add-to-cart], .btn--add-to-cart, [data-action="add-to-cart"], form[action$="/cart/add"] [type="submit"]');
      if (t) {
        gtag('event', 'add_to_cart', {send_to: 'AW-18302569250'});
      }
    }, true);

    // Fetch/XHR safety net for AJAX carts
    var _f = window.fetch;
    if (_f) {
      window.fetch = function(url, opts){
        try {
          var u = (typeof url === 'string') ? url : (url && url.url) || '';
          if (u && u.indexOf('/cart/add') !== -1) {
            gtag('event', 'add_to_cart', {send_to: 'AW-18302569250'});
          }
        } catch(_) {}
        return _f.apply(this, arguments);
      };
    }
  });
</script>
<!-- END Google Ads Tracking -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <title>{% if page_title == blank %}{{ shop.name }}{% else %}{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}{% endif %}</title>
    {% if page_description != blank %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon != blank %}
      <link rel="icon" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {% endif %}
    {{ content_for_header }}
    {{ 'figma-fonts.css' | asset_url | stylesheet_tag }}
    {{ 'figma-poster.css' | asset_url | stylesheet_tag }}
    {{ 'poster-theme.css' | asset_url | stylesheet_tag }}
    {{ 'header-adaptive.css' | asset_url | stylesheet_tag }}
    {{ 'mobile-menu.css' | asset_url | stylesheet_tag }}
    {{ 'header-navigation.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="{{ 'cart-drawer.css' | asset_url }}&psv=shopify-payment-icons-v1-20260819">
    <link rel="stylesheet" href="{{ 'shopify-payment-icons.css' | asset_url }}&psv=shopify-payment-icons-v1-20260819">
    {{ 'search-overlay.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'poster-theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'header-adaptive.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'mobile-menu.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'header-navigation.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}&drawer_build=shopify-payment-icons-v1-20260819" defer="defer"></script>
    <script src="{{ 'search-overlay.js' | asset_url }}" defer="defer"></script>
  </head>
  <body class="store-root template-{{ request.page_type | handle }}">
    {% sections 'header-group' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
    {% render 'cart-drawer' %}
    {% render 'search-overlay' %}
  </body>
</html>
