<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <title>{% if page_title == blank %}{{ shop.name }}{% else %}{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}{% endif %}</title>
    {% if page_description != blank %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon != blank %}
      <link rel="icon" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {% endif %}
    {{ content_for_header }}
    {{ 'figma-fonts.css' | asset_url | stylesheet_tag }}
    {{ 'figma-poster.css' | asset_url | stylesheet_tag }}
    {{ 'poster-theme.css' | asset_url | stylesheet_tag }}
    {{ 'header-adaptive.css' | asset_url | stylesheet_tag }}
    {{ 'mobile-menu.css' | asset_url | stylesheet_tag }}
    {{ 'header-navigation.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="{{ 'cart-drawer.css' | asset_url }}&psv=shopify-payment-icons-v1-20260819">
    <link rel="stylesheet" href="{{ 'shopify-payment-icons.css' | asset_url }}&psv=shopify-payment-icons-v1-20260819">
    {{ 'search-overlay.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'poster-theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'header-adaptive.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'mobile-menu.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'header-navigation.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}&drawer_build=shopify-payment-icons-v1-20260819" defer="defer"></script>
    <script src="{{ 'search-overlay.js' | asset_url }}" defer="defer"></script>
  </head>
  <body class="store-root template-{{ request.page_type | handle }}">
    {% sections 'header-group' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
    {% render 'cart-drawer' %}
    {% render 'search-overlay' %}
  </body>
</html>
