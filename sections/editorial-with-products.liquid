{{ 'editorial-depth-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'editorial-depth-cards.js' | asset_url }}" defer="defer"></script>
{% if section.settings.enable_personalizer %}
  {{ 'custom-artwork-cropper.css' | asset_url | stylesheet_tag }}
  {{ 'home-personalizer.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'custom-artwork-cropper-geometry.js' | asset_url }}&psv=home-personalizer-v1-20260819" defer="defer"></script>
  <script src="{{ 'custom-artwork-cropper-mode.js' | asset_url }}&psv=home-personalizer-v1-20260819" defer="defer"></script>
  <script src="{{ 'home-personalizer.js' | asset_url }}&psv=home-personalizer-v1-20260819" defer="defer"></script>
{% endif %}

<section
  class="section editorial-products{% if section.settings.enable_personalizer %} home-personalizer{% endif %}"
  data-editorial-depth-section
  style="--depth-artwork-padding: {{ section.settings.card_artwork_padding | default: 12 }}%;"
  {% if section.settings.enable_personalizer %}data-home-personalizer data-home-personalizer-id="{{ section.id }}"{% endif %}
>
  <div class="page-width editorial {% if section.settings.image_position == 'right' %}editorial--reverse{% endif %}">
    <div class="editorial__image{% if section.settings.enable_personalizer %} home-personalizer__scene{% endif %}"{% if section.settings.enable_personalizer %} data-home-personalizer-scene{% endif %}>
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '500,750,1000,1500', alt: section.settings.heading }}
      {% else %}
        <img src="{{ section.settings.fallback_image_asset | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1400" height="1750" loading="lazy">
      {% endif %}
      {% if section.settings.enable_personalizer %}
        <div
          class="home-personalizer__wall-preview"
          data-home-personalizer-preview
          data-preview-width="{{ section.settings.preview_width }}"
          style="--home-preview-left: {{ section.settings.preview_left }}%; --home-preview-top: {{ section.settings.preview_top }}%; --home-preview-width: {{ section.settings.preview_width }}%;"
          hidden
        >
          <img data-home-personalizer-preview-image alt="Your uploaded poster preview" width="1200" height="1697">
        </div>
      {% endif %}
    </div>
    <div class="editorial__copy">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {% if section.settings.enable_personalizer %}
        {% render 'home-personalizer-upload', section: section %}
      {% endif %}
      {% if section.settings.link_label != blank %}
        <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }} →</a>
      {% endif %}
    </div>
  </div>

  {% if section.settings.collection != blank or section.blocks.size > 0 %}
    <div class="editorial-depth-shell">
      <div class="page-width editorial-depth-grid" data-editorial-depth-grid>
        {% if section.settings.collection != blank %}
          {% for product in section.settings.collection.products limit: 4 %}
            {% assign product_artist = product.metafields.custom.artist.value | default: product.metafields.custom.artist | default: product.vendor %}
            {% assign hover_media = blank %}
            {% assign discount_badge = section.settings.discount_badge_text %}
            {% if product.media.size > 1 and product.media[1].media_type == 'image' %}
              {% assign hover_media = product.media[1] %}
            {% endif %}
            {% if product.compare_at_price_max > product.price_min and product.compare_at_price_max > 0 %}
              {% assign discount_saving = product.compare_at_price_max | minus: product.price_min %}
              {% assign discount_percentage = discount_saving | times: 100.0 | divided_by: product.compare_at_price_max | round %}
              {% assign discount_badge = 'Discount ' | append: discount_percentage | append: '%' %}
            {% endif %}
            <article
              class="editorial-depth-card{% if hover_media != blank %} has-hover-image{% endif %}"
              data-depth-card
              data-product-handle="{{ product.handle | escape }}"
            >
              <a class="editorial-depth-card__surface" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                <span class="editorial-depth-card__media">
                  {% if product.featured_media %}
                    {{ product.featured_media | image_url: width: 1200 | image_tag: class: 'editorial-depth-card__image editorial-depth-card__image--primary', loading: 'lazy', widths: '400,600,800,1200', alt: product.title }}
                  {% endif %}
                </span>
                {% if hover_media != blank %}
                  {{ hover_media | image_url: width: 1200 | image_tag: class: 'editorial-depth-card__image editorial-depth-card__image--hover', loading: 'lazy', widths: '400,600,800,1200', alt: '' }}
                {% endif %}
                {% if discount_badge != blank %}<span class="editorial-depth-card__badge">{{ discount_badge }}</span>{% endif %}
              </a>
              <div class="editorial-depth-card__content">
                {% if product_artist != blank %}<p class="editorial-depth-card__eyebrow">{{ product_artist }}</p>{% endif %}
                <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
                <p class="editorial-depth-card__price">
                  <span>From {{ product.price_min | money }}</span>
                  {% if product.compare_at_price_max > product.price_min %}<s>{{ product.compare_at_price_max | money }}</s>{% endif %}
                </p>
              </div>
            </article>
          {% endfor %}
        {% else %}
          {% for block in section.blocks %}
            <article class="editorial-depth-card" data-depth-card {{ block.shopify_attributes }}>
              <a class="editorial-depth-card__surface" href="{{ block.settings.link }}" aria-label="View {{ block.settings.title | escape }}">
                <span class="editorial-depth-card__media">
                  <img class="editorial-depth-card__image editorial-depth-card__image--primary" src="{{ block.settings.asset_name | asset_url }}" alt="{{ block.settings.title | escape }}" width="900" height="1350" loading="lazy">
                </span>
              </a>
              <div class="editorial-depth-card__content">
                {% if block.settings.meta != blank %}<p class="editorial-depth-card__eyebrow">{{ block.settings.meta }}</p>{% endif %}
                <h3><a href="{{ block.settings.link }}">{{ block.settings.title }}</a></h3>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if section.settings.enable_personalizer %}
    {% render 'home-personalizer-cropper', section: section %}
  {% endif %}

  {% if section.settings.enable_personalizer %}
    {% render 'home-personalizer-cropper', section: section %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Editorial with products",
  "settings": [
    {"type":"image_picker","id":"image","label":"Shopify image override"},
    {"type":"text","id":"fallback_image_asset","label":"Bundled Figma image filename"},
    {"type":"select","id":"image_position","label":"Image position","default":"left","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Editorial / Vol. 03"},
    {"type":"text","id":"heading","label":"Heading","default":"Nordic Calm."},
    {"type":"textarea","id":"text","label":"Text","default":"Muted palettes, clean lines, and Scandinavian wisdom—prints that make any room breathe."},
    {"type":"text","id":"link_label","label":"Link label","default":"Explore the series"},
    {"type":"url","id":"link","label":"Link"},
    {"type":"collection","id":"collection","label":"Products collection"},
    {"type":"range","id":"card_artwork_padding","label":"Product card artwork margin","min":1,"max":20,"step":1,"unit":"%","default":12},
    {"type":"text","id":"discount_badge_text","label":"Discount badge before compare-at pricing","default":"Discount"},
    {"type":"header","content":"Homepage personalizer"},
    {"type":"checkbox","id":"enable_personalizer","label":"Enable upload preview","default":false},
    {"type":"text","id":"upload_heading","label":"Upload heading","default":"Upload your image"},
    {"type":"text","id":"upload_button_label","label":"Upload button label","default":"Choose image"},
    {"type":"text","id":"upload_help_text","label":"Upload help text","default":"JPEG, PNG or WebP · maximum 20 MB and 20 megapixels."},
    {"type":"text","id":"crop_heading","label":"Crop dialog heading","default":"Crop your image"},
    {"type":"textarea","id":"crop_help_text","label":"Crop dialog help text","default":"Choose one of the three fixed poster ratios, then position and resize the crop area."},
    {"type":"text","id":"crop_cancel_label","label":"Crop cancel label","default":"Cancel"},
    {"type":"text","id":"crop_confirm_label","label":"Crop confirm label","default":"Use crop"},
    {"type":"range","id":"preview_left","label":"Preview horizontal position","min":10,"max":90,"step":1,"unit":"%","default":57},
    {"type":"range","id":"preview_top","label":"Preview vertical position","min":10,"max":90,"step":1,"unit":"%","default":32},
    {"type":"range","id":"preview_width","label":"Preview width","min":20,"max":75,"step":1,"unit":"%","default":50}
  ],
  "blocks": [
    {"type":"poster","name":"Figma poster","settings":[
      {"type":"text","id":"asset_name","label":"Bundled Figma asset filename"},
      {"type":"text","id":"title","label":"Title"},
      {"type":"text","id":"meta","label":"Meta"},
      {"type":"url","id":"link","label":"Product link"}
    ]}
  ],
  "max_blocks": 4,
  "presets": [{"name":"Editorial with products"}]
}
{% endschema %}




