{%- assign visible_cart_count = 0 -%}
{%- for item in cart.items -%}{%- if item.properties._framing_component == blank -%}{%- assign visible_cart_count = visible_cart_count | plus: item.quantity -%}{%- endif -%}{%- endfor -%}
<header class="site-header site-header--adaptive{% unless request.page_type == 'index' %} site-header--solid{% endunless %}" data-adaptive-header>
  <div class="page-width site-header__inner">
    <a class="site-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {% render 'site-logo' %}
    </a>
    <nav class="site-nav" aria-label="Main navigation" data-header-navigation="desktop">
      {% if section.settings.menu != blank %}
        <ul class="site-nav__list" role="list">
          {% for link in section.settings.menu.links %}
            <li class="site-nav__item{% if link.links != blank %} site-nav__item--has-children{% endif %}">
              {% if link.links != blank %}
                {% assign submenu_id = 'HeaderSubmenu-' | append: section.id | append: '-' | append: forloop.index %}
                <button class="site-nav__control site-nav__toggle" type="button" aria-expanded="false" aria-controls="{{ submenu_id }}" aria-haspopup="true" data-header-submenu-toggle data-menu-title="{{ link.title | escape }}">
                  <span>{{ link.title | escape }}</span>
                  <span class="site-nav__chevron" aria-hidden="true"></span>
                </button>
                <div class="site-nav__submenu" id="{{ submenu_id }}" data-header-submenu hidden>
                  <ul role="list">
                    {% for child_link in link.links %}
                      <li><a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %} data-header-submenu-link data-parent-menu="{{ link.title | escape }}">{{ child_link.title | escape }}</a></li>
                    {% endfor %}
                  </ul>
                </div>
              {% else %}
                <a class="site-nav__control" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <a href="#categories">Shop</a><a href="#categories">Collections</a><a href="#categories">About</a><a href="#categories">Journal</a>
      {% endif %}
    </nav>
    <div class="site-actions">
      <button class="icon-button mobile-menu-trigger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-mobile-menu-open>
        <span class="mobile-menu-trigger__lines" aria-hidden="true"></span>
      </button>
      <a class="icon-button" aria-label="{{ 'general.search' | t }}" href="{{ routes.search_url }}" data-search-overlay-open>{% render 'icon', name: 'search' %}</a>
      <a class="icon-button" aria-label="{{ 'general.cart' | t }}" href="{{ routes.cart_url }}" data-cart-drawer-open>{% render 'icon', name: 'bag' %}<span class="cart-count"{% if visible_cart_count == 0 %} hidden{% endif %}>{{ visible_cart_count }}</span></a>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu" data-mobile-menu aria-hidden="true">
    <button class="mobile-menu__backdrop" type="button" aria-label="Close menu" data-mobile-menu-close></button>
    <aside class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Main navigation" tabindex="-1">
      <div class="mobile-menu__head">
        <span class="site-logo" aria-hidden="true">
          {% render 'site-logo' %}
        </span>
        <button class="mobile-menu__close" type="button" aria-label="Close menu" data-mobile-menu-close>×</button>
      </div>
      <nav class="mobile-menu__links" aria-label="Mobile navigation" data-header-navigation="mobile">
        {% if section.settings.menu != blank %}
          <ul class="mobile-nav__list" role="list">
            {% for link in section.settings.menu.links %}
              <li class="mobile-nav__item{% if link.links != blank %} mobile-nav__item--has-children{% endif %}">
                {% if link.links != blank %}
                  {% assign mobile_submenu_id = 'MobileHeaderSubmenu-' | append: section.id | append: '-' | append: forloop.index %}
                  <button class="mobile-nav__toggle" type="button" aria-expanded="false" aria-controls="{{ mobile_submenu_id }}" data-header-submenu-toggle data-menu-title="{{ link.title | escape }}">
                    <span>{{ link.title | escape }}</span>
                    <span class="mobile-nav__chevron" aria-hidden="true"></span>
                  </button>
                  <div class="mobile-nav__submenu" id="{{ mobile_submenu_id }}" data-header-submenu hidden>
                    <ul role="list">
                      {% for child_link in link.links %}
                        <li><a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %} data-header-submenu-link data-parent-menu="{{ link.title | escape }}">{{ child_link.title | escape }}</a></li>
                      {% endfor %}
                    </ul>
                  </div>
                {% else %}
                  <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <a href="#categories">Shop</a><a href="#categories">Collections</a><a href="#categories">About</a><a href="#categories">Journal</a>
        {% endif %}
      </nav>
    </aside>
  </div>
</header>
{% schema %}
{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}
{% endschema %}
