{{ 'custom-product.css' | asset_url | stylesheet_tag }}
{{ 'custom-artwork-upload.css' | asset_url | stylesheet_tag }}
{{ 'custom-artwork-cropper.css' | asset_url | stylesheet_tag }}
{{ 'product-size-guide.css' | asset_url | stylesheet_tag }}
{% assign framing_render_mode = section.settings.framing_render_mode | default: 'image' %}
{% if framing_render_mode == 'css' %}
  <link rel="stylesheet" href="{{ 'custom-css-framing.css' | asset_url }}&psv=plain-frame-finish-v1-20260818">
{% else %}
  {{ 'custom-image-framing.css' | asset_url | stylesheet_tag }}
{% endif %}
<script src="{{ 'custom-artwork-cropper-geometry.js' | asset_url }}&psv=crop-modes-v2-20260819" defer="defer"></script>
<script src="{{ 'custom-artwork-cropper-mode.js' | asset_url }}&psv=crop-modes-v2-20260819" defer="defer"></script>
<script src="{{ 'custom-artwork-cropper.js' | asset_url }}&psv=crop-modes-v2-20260819" defer="defer"></script>
<script src="{{ 'framing-option-visibility.js' | asset_url }}&psv=framing-visibility-20260818" defer="defer"></script>
<script src="{{ 'custom-framing-catalog.js' | asset_url }}&psv=complete-largest-framing-20260825" defer="defer"></script>
{% if framing_render_mode == 'css' %}
  <script src="{{ 'custom-css-framing.js' | asset_url }}&psv=css-framing-20260817" defer="defer"></script>
{% else %}
  <script src="{{ 'custom-image-framing.js' | asset_url }}&psv=image-framing-20260814" defer="defer"></script>
{% endif %}
<script src="{{ 'custom-framing.js' | asset_url }}&psv=framing-visibility-20260818" defer="defer"></script>
<script src="{{ 'custom-artwork-upload.js' | asset_url }}&psv=cropper-20260814" defer="defer"></script>
<script src="{{ 'custom-product-cart.js' | asset_url }}&psv=artwork-upload-20260814" defer="defer"></script>
<script src="{{ 'custom-product.js' | asset_url }}&psv=artwork-upload-20260814" defer="defer"></script>
<script src="{{ 'product-sale-badge.js' | asset_url }}&psv=variant-discount-v1-20260825" defer="defer"></script>
<script src="{{ 'product-size-guide.js' | asset_url }}&psv=size-guide-v1-20260821" defer="defer"></script>

{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign preview_media = product.media | where: 'media_type', 'image' | last %}
{% assign css_oak_texture_scale = section.settings.css_oak_texture_scale | default: 100 %}
{% assign css_oak_texture_bottom_offset = css_oak_texture_scale | times: 47 | divided_by: 100 %}
{% assign css_oak_texture_left_offset = css_oak_texture_scale | times: 53 | divided_by: 100 %}
{% capture product_form_id %}custom-product-form-{{ section.id }}{% endcapture %}

<section
  class="ps-product ps-section"
  data-ps-product
  data-ps-product-id="{{ product.id }}"
  data-ps-product-context="custom"
  data-section-id="{{ section.id }}"
  data-ps-framing-render-mode="{{ framing_render_mode }}"
  {% if framing_render_mode == 'css' %}
    style="--ps-css-oak-texture-size: {{ css_oak_texture_scale }}px; --ps-css-oak-texture-bottom-offset: {{ css_oak_texture_bottom_offset }}px; --ps-css-oak-texture-left-offset: {{ css_oak_texture_left_offset }}px;"
  {% endif %}
>
  <div class="ps-shell">
    {% if section.settings.show_breadcrumb %}
      <nav class="ps-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a><span>/</span>
        {% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a><span>/</span>{% endif %}
        <span aria-current="page">{{ product.title }}</span>
      </nav>
    {% endif %}

    <div class="ps-layout">
      <div class="ps-left">
        <div class="ps-media-stage">
          <div class="ps-main-media">
            <print-preview class="ps-print-preview" data-ps-art-preview data-orientation="portrait" data-media-id="{{ preview_media.id | default: product.media.first.id }}" style="--pdp-aspect: {% if preview_media %}{{ preview_media.preview_image.width }} / {{ preview_media.preview_image.height }}{% else %}800 / 1100{% endif %};">
              <div class="print-preview__inner" data-pdp-print-preview data-pdp-canvas data-ps-preview-canvas>
                <div class="print-preview__bg" aria-hidden="true"></div>
                <div class="ps-css-frame" data-ps-css-frame data-has-frame="false">
                  <div class="ps-css-mat" data-ps-css-mat data-has-mat="false">
                    {% if framing_render_mode == 'css' %}
                      {% render 'css-frame-rails' %}
                    {% endif %}
                    <div class="ps-css-artwork" data-ps-css-artwork>
                      {% render 'product-preview-artwork', preview_media: preview_media, product: product %}
                    </div>
                  </div>
                </div>
                <img class="print-preview__layer print-preview__layer--passepartout" data-ps-framing-layer="passepartout" width="800" height="1100" alt="" hidden aria-hidden="true">
                <img class="print-preview__layer print-preview__layer--frame" data-ps-framing-layer="frame" width="800" height="1100" alt="" hidden aria-hidden="true">
              </div>
            </print-preview>
            <button class="ps-media-navigation ps-media-navigation--previous" type="button" data-ps-media-direction="-1" aria-label="Show previous image"><svg class="ps-action-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6" /></svg></button>
            <button class="ps-media-navigation ps-media-navigation--next" type="button" data-ps-media-direction="1" aria-label="Show next image"><svg class="ps-action-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6" /></svg></button>
          </div>
        </div>
        <div class="ps-details-relocation-anchor" data-ps-details-desktop-anchor aria-hidden="true"></div>
        <div class="ps-left-details" data-ps-accordions>
          <section class="ps-accordion-panel" data-ps-accordion>
            <button class="ps-accordion-panel__trigger" type="button" data-ps-accordion-trigger aria-expanded="false" aria-controls="ps-product-details-{{ section.id }}">
              <span>{{ section.settings.customer_notice_heading }}</span><span class="ps-accordion-panel__icon" aria-hidden="true">+</span>
            </button>
            <div class="ps-accordion-panel__body" id="ps-product-details-{{ section.id }}" data-ps-accordion-panel aria-hidden="true">
              <div class="ps-accordion-panel__body-inner">
                <div class="ps-detail-content rte">{{ section.settings.customer_notice_content }}</div>
              </div>
            </div>
          </section>
          <section class="ps-accordion-panel" data-ps-accordion>
            <button class="ps-accordion-panel__trigger" type="button" data-ps-accordion-trigger aria-expanded="false" aria-controls="ps-shipping-returns-{{ section.id }}">
              <span>{{ section.settings.shipping_returns_heading }}</span><span class="ps-accordion-panel__icon" aria-hidden="true">+</span>
            </button>
            <div class="ps-accordion-panel__body" id="ps-shipping-returns-{{ section.id }}" data-ps-accordion-panel aria-hidden="true">
              <div class="ps-accordion-panel__body-inner">
                <div class="ps-detail-content">{{ section.settings.shipping_returns_content }}</div>
              </div>
            </div>
          </section>
        </div>
      </div>

      <aside class="ps-purchase" aria-label="Purchase {{ product.title | escape }}">
        {% form 'product', product, id: product_form_id, class: 'ps-form', data_ps_form: '' %}
          <input type="hidden" name="id" value="{{ selected_variant.id }}" data-ps-variant-input>
          {% for block in section.blocks %}
            {% render 'custom-product-purchase-block', block: block, product: product, section: section, selected_variant: selected_variant, form_id: product_form_id %}
          {% endfor %}
        {% endform %}
        <div class="ps-details-relocation-anchor" data-ps-details-mobile-anchor aria-hidden="true"></div>
      </aside>
    </div>

  </div>

  {% render 'product-size-guide', product: product, section: section %}
</section>

<script type="application/json" data-ps-variants>
  {{ product.variants | json }}
</script>
{% render 'custom-framing-catalog', section: section %}

{% schema %}
{
  "name": "Custom product main",
  "settings": [
    {
      "type": "select",
      "id": "framing_render_mode",
      "label": "Frame preview rendering",
      "options": [
        {
          "value": "image",
          "label": "Image assets"
        },
        {
          "value": "css",
          "label": "CSS rendering"
        }
      ],
      "default": "image"
    },
    {
      "type": "header",
      "content": "CSS frame texture"
    },
    {
      "type": "range",
      "id": "css_oak_texture_scale",
      "min": 40,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "Oak texture scale",
      "info": "Lower values make the wood grain smaller and denser.",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "customer_notice_heading",
      "label": "Customer notice heading",
      "default": "Customer Notice"
    },
    {
      "type": "richtext",
      "id": "customer_notice_content",
      "label": "Customer notice content",
      "default": "<ul><li>By uploading an image, you confirm that you own the copyright or have obtained all necessary permissions to use it.</li><li>Do not upload film, television, anime, brand, celebrity, illegal, or otherwise prohibited content.</li><li>We reserve the right to refuse any order suspected of infringing intellectual property or other rights.</li><li>Uploaded files are retained and deleted in accordance with our stated file-retention and deletion procedures.</li><li>You grant us a limited licence to use the uploaded image solely as necessary to produce and fulfil your order.</li><li>We maintain a complaint and takedown process for reporting and removing potentially infringing content.</li></ul>"
    },
    {
      "type": "text",
      "id": "shipping_returns_heading",
      "label": "Shipping and returns heading",
      "default": "Shipping and returns"
    },
    {
      "type": "richtext",
      "id": "shipping_returns_content",
      "label": "Shipping and returns content",
      "default": "<p>Each order is made for you. Delivery estimates are shown before checkout.</p>"
    },
    {
      "type": "product",
      "id": "passepartout_product",
      "label": "Passepartout add-on product"
    },
    {
      "type": "product",
      "id": "frame_product",
      "label": "Frame add-on product"
    }
  ],
  "max_blocks": 30,
  "blocks": [
    {
      "type": "sale_badge",
      "name": "Sale badge",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Save" }
      ]
    },
    {
      "type": "reviews",
      "name": "Review summary",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Verified reviews" }
      ]
    },
    {
      "type": "title",
      "name": "Product title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "vendor",
      "name": "Artist or vendor",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Artist:" }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "shipping_note",
      "name": "Shipping note",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on qualifying orders." }
      ]
    },
    {
      "type": "artwork_upload",
      "name": "Artwork upload",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "upload_heading", "label": "Upload heading", "default": "Upload your image" },
        { "type": "text", "id": "drop_label", "label": "Dropzone label", "default": "Drag and drop your image here" },
        { "type": "text", "id": "or_label", "label": "Separator label", "default": "or" },
        { "type": "text", "id": "upload_button_label", "label": "Upload button", "default": "Choose image" },
        { "type": "text", "id": "upload_help_text", "label": "Upload help text", "default": "JPEG, PNG or WebP · maximum 20 MB and 20 megapixels." },
        { "type": "text", "id": "remove_label", "label": "Remove button", "default": "Remove" },
        { "type": "checkbox", "id": "require_artwork", "label": "Require an image before add to cart", "default": true },
        { "type": "header", "content": "Crop dialog" },
        { "type": "text", "id": "crop_heading", "label": "Heading", "default": "Crop your image" },
        { "type": "text", "id": "crop_help_text", "label": "Image-mode help text", "default": "Choose a supported frame ratio, then position and resize the crop area." },
        { "type": "text", "id": "crop_css_help_text", "label": "CSS-mode help text", "default": "Choose a fixed ratio, or select Free crop to adjust the shape freely." },
        { "type": "text", "id": "crop_close_label", "label": "Close accessibility label", "default": "Close image cropper" },
        { "type": "text", "id": "landscape_label", "label": "Landscape option", "default": "Landscape" },
        { "type": "text", "id": "square_label", "label": "Square option", "default": "Square" },
        { "type": "text", "id": "portrait_label", "label": "Portrait option", "default": "Portrait" },
        { "type": "text", "id": "free_crop_label", "label": "Free crop option", "default": "Free crop" },
        { "type": "text", "id": "any_ratio_label", "label": "Free crop ratio label", "default": "Any ratio" },
        { "type": "textarea", "id": "fixed_instruction", "label": "Fixed crop instruction", "default": "Drag to reposition. Drag a corner to resize while keeping the selected ratio." },
        { "type": "textarea", "id": "freeform_instruction", "label": "Free crop instruction", "default": "Drag to reposition. Drag any corner to resize freely." },
        { "type": "text", "id": "crop_cancel_label", "label": "Cancel button", "default": "Cancel" },
        { "type": "text", "id": "crop_confirm_label", "label": "Confirm button", "default": "Use crop" }
      ]
    },
    {
      "type": "material",
      "name": "Material",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Material:" },
        { "type": "text", "id": "value", "label": "Value", "default": "Poster" }
      ]
    },
    {
      "type": "size_selector",
      "name": "Size selector",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Size:" },
        { "type": "text", "id": "guide_label", "label": "Size guide label", "default": "Size guide" }
      ]
    },
    {
      "type": "variant_options",
      "name": "Other variant options",
      "limit": 1,
      "settings": []
    },
    {
      "type": "passepartout",
      "name": "Passepartout selector",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Passepartout:" },
        { "type": "text", "id": "empty_value", "label": "Empty value", "default": "None" },
        { "type": "text", "id": "add_label", "label": "Add label", "default": "Add passepartout" },
        { "type": "text", "id": "loading_label", "label": "Loading label", "default": "Loading…" },
        { "type": "text", "id": "options_label", "label": "Options accessibility label", "default": "Passepartout options" }
      ]
    },
    {
      "type": "frame",
      "name": "Frame selector",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Frame:" },
        { "type": "text", "id": "empty_value", "label": "Empty value", "default": "No frame" },
        { "type": "text", "id": "add_label", "label": "Add label", "default": "Add frame" },
        { "type": "text", "id": "loading_label", "label": "Loading label", "default": "Loading…" },
        { "type": "text", "id": "options_label", "label": "Options accessibility label", "default": "Frame options" }
      ]
    },
    {
      "type": "hanging_kit",
      "name": "Scroll rod",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Scroll Rod" }
      ]
    },
    {
      "type": "quantity",
      "name": "Quantity selector",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Quantity" },
        { "type": "text", "id": "decrease_label", "label": "Decrease accessibility label", "default": "Decrease quantity" },
        { "type": "text", "id": "increase_label", "label": "Increase accessibility label", "default": "Increase quantity" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "add_label", "label": "Available label", "default": "Add to cart" },
        { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
        { "type": "text", "id": "unavailable_label", "label": "Unavailable label", "default": "Unavailable" }
      ]
    },
    {
      "type": "quantity_offer",
      "name": "Quantity offer",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "SUMMER OFFER" },
        { "type": "text", "id": "summary", "label": "Summary", "default": "BUY3+ Save 15%" },
        { "type": "text", "id": "toggle_label", "label": "Toggle label", "default": "more" },
        { "type": "checkbox", "id": "default_open", "label": "Open by default", "default": false },
        { "type": "header", "content": "Table headings" },
        { "type": "text", "id": "column_one_heading", "label": "First column", "default": "Buy quantity" },
        { "type": "text", "id": "column_two_heading", "label": "Second column", "default": "Discount" },
        { "type": "header", "content": "Table row 1" },
        { "type": "text", "id": "row_1_label", "label": "First column", "default": "Buy 1" },
        { "type": "text", "id": "row_1_value", "label": "Second column", "default": "Standard price" },
        { "type": "header", "content": "Table row 2" },
