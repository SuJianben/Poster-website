{{ 'collection-gallery.css' | asset_url | append: '&cg=20260821-spacing-1' | stylesheet_tag }}
<script src="{{ 'collection-gallery.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'collection-filters.js' | asset_url }}" defer="defer"></script>

{% assign collection_count = collection.products_count %}
{% if collection.handle == 'all' %}{% assign collection_count = collection_count | minus: 2 %}{% endif %}
{% assign seo_title = collection.metafields.custom.collection_seo_title.value | default: collection.title %}
{% assign seo_intro = collection.metafields.custom.collection_seo_intro.value | default: section.settings.seo_intro %}
{% assign seo_body = collection.metafields.custom.collection_seo_body.value | default: collection.description | default: section.settings.seo_body %}

<section
  class="cg-collection"
  data-cg-collection
  data-cg-product-collection
  data-cg-section-id="{{ section.id }}"
  data-cg-collection-handle="{{ collection.handle }}"
  data-columns="4"
  data-view="product"
>
  <div class="cg-shell">
    <div class="cg-breadcrumb">{{ collection.title }}</div>
    <header class="cg-heading">
      <h1>{{ collection.title }} <span data-cg-product-count>({{ collection_count }})</span></h1>
      {% if collection.description != blank %}
        <div>{{ collection.description }}</div>
      {% else %}
        <p>{{ section.settings.fallback_description }}</p>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <nav class="cg-category-nav" aria-label="Room collections">
        {% for block in section.blocks %}
          {% assign navigation_collection = block.settings.collection %}
          {% if navigation_collection != blank %}
            {% assign navigation_label = block.settings.label | default: navigation_collection.title %}
            <a
              class="{% if navigation_collection.handle == collection.handle %}is-current{% endif %}"
              href="{{ navigation_collection.url }}"
              {% if navigation_collection.handle == collection.handle %}aria-current="page"{% endif %}
              {{ block.shopify_attributes }}
            >{{ navigation_label }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}

    <div class="cg-toolbar">
      <div class="cg-tool-group">
        <span class="cg-toolbar-label">Gallery:</span>
        <div class="cg-segment" aria-label="Gallery columns">
          <button type="button" data-cg-columns="3">3</button>
          <button type="button" class="is-active" data-cg-columns="4">4</button>
          <button type="button" data-cg-columns="6">6</button>
        </div>
        <span class="cg-toolbar-label">View:</span>
        <div class="cg-segment" aria-label="Gallery view">
          <button type="button" class="is-active" data-cg-view="product" aria-pressed="true">Product</button>
          <button type="button" data-cg-view="lifestyle" aria-pressed="false">Lifestyle</button>
        </div>
      </div>
      <button class="cg-filter-trigger" type="button" data-cg-open-drawer aria-haspopup="dialog">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 4h13M4.5 8h7M6.5 12h3" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
        Filters
      </button>
    </div>

    {% paginate collection.products by 24 %}
    <div class="cg-results" data-cg-results aria-live="polite">
      <div class="cg-product-grid">
        {% for product in collection.products %}
          {% if product.tags contains 'system:framing-addon' %}{% continue %}{% endif %}
          {% assign discount_badge = section.settings.discount_badge_text %}
          {% if product.compare_at_price_max > product.price_min and product.compare_at_price_max > 0 %}
            {% assign discount_saving = product.compare_at_price_max | minus: product.price_min %}
            {% assign discount_percentage = discount_saving | times: 100.0 | divided_by: product.compare_at_price_max | round %}
            {% assign discount_badge = 'Discount ' | append: discount_percentage | append: '%' %}
          {% endif %}
          <article
            class="cg-product"
            data-cg-product
            data-cg-has-lifestyle="{% if product.images.size > 1 %}true{% else %}false{% endif %}"
            data-product-handle="{{ product.handle | escape }}"
          >
            <a class="cg-product-media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if discount_badge != blank %}<span class="cg-badge">{{ discount_badge }}</span>{% endif %}
              {% if product.featured_media %}
                {{ product.featured_media | image_url: width: 1200 | image_tag: class: 'cg-product-image', loading: 'lazy', widths: '320,480,640,800,1200', alt: product.title }}
              {% endif %}
              {% if product.images.size > 1 %}
                {{ product.images[1] | image_url: width: 1200 | image_tag: class: 'cg-product-hover-image', loading: 'lazy', widths: '320,480,640,800,1200', alt: '' }}
              {% endif %}
            </a>
            <div class="cg-product-meta">
              <a class="cg-product-title" href="{{ product.url }}">{{ product.title }}</a>
              <span class="cg-product-price">From {{ product.price | money }}</span>
              {% if product.vendor != blank %}<span class="cg-product-vendor">{{ product.vendor }}</span>{% endif %}
            </div>
          </article>
        {% else %}
          <p class="cg-product-grid__empty">No products are available in this collection yet.</p>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="cg-pagination" aria-label="Product pages">
          {% if paginate.previous %}
            <a class="cg-pagination__previous" href="{{ paginate.previous.url }}" aria-label="Previous page">‹</a>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {% else %}
              <span{% if part.title == paginate.current_page %} class="is-current" aria-current="page"{% endif %}>{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a class="cg-pagination__next" href="{{ paginate.next.url }}" aria-label="Next page">›</a>
          {% endif %}
        </nav>
      {% endif %}
    </div>
    {% endpaginate %}

    {% if section.settings.show_seo %}
      <section class="cg-seo" aria-labelledby="cg-seo-title">
        <h2 id="cg-seo-title">{{ seo_title }}</h2>
        {% if seo_intro != blank %}<p class="cg-seo__lead">{{ seo_intro }}</p>{% endif %}
        {% if seo_body != blank %}<div>{{ seo_body }}</div>{% endif %}
      </section>
    {% endif %}
  </div>

  <div class="cg-drawer" data-cg-drawer aria-hidden="true">
    <button class="cg-drawer__scrim" type="button" data-cg-close-drawer aria-label="Close filters"></button>
    <aside class="cg-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cg-filter-title">
      <div class="cg-drawer__head">
        <h2 id="cg-filter-title">Filters</h2>
        <button class="cg-drawer-close" type="button" data-cg-close-drawer aria-label="Close filters">×</button>
      </div>
      {% liquid
        assign current_sort = collection.sort_by | default: collection.default_sort_by
        capture clear_filters_url
          echo collection.url
          echo '?sort_by='
          echo current_sort | url_encode
        endcapture
      %}
      <form class="cg-filter-form" action="{{ collection.url }}" method="get" data-cg-filter-form>
        <details class="cg-native-filter" open>
          <summary>
            <span>Sort by</span>
            <span class="cg-native-filter__toggle" aria-hidden="true"></span>
          </summary>
          <div class="cg-native-filter__body">
            <ul class="cg-sort-values" role="list">
              {% for option in collection.sort_options %}
                <li>
                  <label class="cg-sort-option" for="SortBy-{{ option.value | escape }}">
                    <input
                      id="SortBy-{{ option.value | escape }}"
                      type="radio"
                      name="sort_by"
                      value="{{ option.value }}"
                      {% if option.value == current_sort %}checked{% endif %}
                    >
                    <span>{{ option.name }}</span>
                  </label>
                </li>
              {% endfor %}
            </ul>
          </div>
        </details>

        {% for filter in collection.filters %}
          {% render 'storefront-filter-group', filter: filter %}
        {% endfor %}

        <div class="cg-filter-actions">
          <a href="{{ clear_filters_url }}">Clear all</a>
          <button type="submit">Show {{ collection_count }} results</button>
        </div>
      </form>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Collection gallery",
  "settings": [
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Fallback description",
      "default": "A curated selection of art prints for the room that brings people together. Each piece is chosen to anchor the space with personality, warmth and lasting visual presence."
    },
    {
      "type": "checkbox",
      "id": "show_seo",
      "label": "Show collection SEO content",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_badge_text",
      "label": "Discount badge before compare-at pricing",
      "default": "Discount"
    },
    {
      "type": "textarea",
      "id": "seo_intro",
      "label": "SEO fallback intro",
      "default": "Discover a curated selection created to bring a distinct point of view to your space."
    },
    {
      "type": "richtext",
      "id": "seo_body",
      "label": "SEO fallback body",
      "default": "<p>Explore art chosen for its character, colour and lasting visual presence. Each piece is designed to help make your room feel personal and complete.</p>"
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "collection_link",
      "name": "Collection link",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label",
          "info": "Leave blank to use the collection title."
        }
      ]
    }
  ]
}
{% endschema %}



