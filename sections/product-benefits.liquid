{{ 'product-showcase.css' | asset_url | stylesheet_tag }}

<section class="ps-benefits ps-section" aria-label="{{ section.settings.accessibility_label | escape }}">
  {% for block in section.blocks %}
    <div class="ps-benefit-item" {{ block.shopify_attributes }}>
      <div class="ps-benefit-icon">
        {% render 'product-benefit-icon', icon: block.settings.icon %}
      </div>
      <div class="ps-benefit-copy">
        <strong>{{ block.settings.title }}</strong>
        <span>{{ block.settings.text }}</span>
      </div>
    </div>
  {% endfor %}
</section>

{% schema %}
{
  "name": "Product benefits",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Shopping benefits"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "quality",
          "options": [
            { "value": "quality", "label": "Premium quality" },
            { "value": "guarantee", "label": "Money-back guarantee" },
            { "value": "shipping", "label": "Free shipping" },
            { "value": "returns", "label": "Returns" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium quality"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Made with carefully selected materials."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "quality",
            "title": "Premium quality",
            "text": "Made with carefully selected materials."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "guarantee",
            "title": "Satisfied or money back",
            "text": "Shop with confidence."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shipping",
            "title": "Free shipping",
            "text": "On qualifying orders."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "returns",
            "title": "30 days return right",
            "text": "Easy returns when eligible."
          }
        }
      ]
    }
  ]
}
{% endschema %}
