<link rel="stylesheet" href="{{ 'home-customer-reviews.css' | asset_url }}&hrw=newsletter-heading-v1-20260820">

<section
  class="hrw-section"
  aria-labelledby="hrw-heading-{{ section.id }}"
  data-home-customer-reviews
  data-review-content-source="theme-editor"
>
  <div class="hrw-section__inner page-width">
    <header class="hrw-section__header">
      {% if section.settings.heading != blank %}
        <h2 class="hrw-section__heading" id="hrw-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a class="hrw-section__link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {% endif %}
    </header>

    <div class="hrw-section__layout">
      <div class="hrw-section__summary">
        {% if section.settings.score != blank %}
          <p class="hrw-section__score">{{ section.settings.score | escape }}</p>
        {% endif %}

        <div
          class="hrw-section__stars hrw-section__stars--summary"
          role="img"
          aria-label="{{ section.settings.summary_stars }} out of 5 stars"
        >
          <span aria-hidden="true">{{ '★★★★★' | slice: 0, section.settings.summary_stars }}</span>
        </div>

        {% if section.settings.summary_label != blank %}
          <p class="hrw-section__summary-label">{{ section.settings.summary_label | escape }}</p>
        {% endif %}

        {% if section.settings.summary_note != blank %}
          <p class="hrw-section__summary-note">{{ section.settings.summary_note | escape | newline_to_br }}</p>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="hrw-section__cards" role="list">
          {% for block in section.blocks %}
            <article class="hrw-card" role="listitem" {{ block.shopify_attributes }}>
              <div class="hrw-section__stars" role="img" aria-label="{{ block.settings.stars }} out of 5 stars">
                <span aria-hidden="true">{{ '★★★★★' | slice: 0, block.settings.stars }}</span>
              </div>

              {% if block.settings.label != blank %}
                <p class="hrw-card__label">{{ block.settings.label | escape }}</p>
              {% endif %}

              {% if block.settings.text != blank %}
                <blockquote class="hrw-card__quote">{{ block.settings.text | escape | newline_to_br }}</blockquote>
              {% endif %}

              {% if block.settings.author != blank %}
                <p class="hrw-card__author">{{ block.settings.author | escape }}</p>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "home-customer-reviews-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "score",
      "label": "Overall score",
      "default": "4.8"
    },
    {
      "type": "range",
      "id": "summary_stars",
      "label": "Overall star count",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "summary_label",
      "label": "Summary label",
      "default": "Highly rated"
    },
    {
      "type": "textarea",
      "id": "summary_note",
      "label": "Summary note",
      "default": "Customer feedback shared with PosterAndForm."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View more reviews"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Star count",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "label",
          "label": "Review label",
          "default": "Customer feedback"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Beautifully made and carefully packaged."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "text": "Beautifully made and carefully packaged."
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "A simple way to bring more character into a room."
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "Thoughtful presentation with a clean, modern finish."
          }
        }
      ]
    }
  ]
}
{% endschema %}
