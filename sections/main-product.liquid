{% assign framing_render_mode = 'image' %}
{% if section.settings.enable_css_framing_preview %}
  {% assign framing_render_mode = 'css' %}
{% endif %}
<link rel="stylesheet" href="{{ 'product-showcase.css' | asset_url }}&psv=default-css-mat-scale-v1-20260819">
{{ 'product-size-guide.css' | asset_url | stylesheet_tag }}
{% if framing_render_mode == 'css' %}
  <link rel="stylesheet" href="{{ 'custom-css-framing.css' | asset_url }}&psv=default-product-toggle-v1-20260819">
{% endif %}
<script src="{{ 'framing-option-visibility.js' | asset_url }}&psv=framing-visibility-20260818" defer="defer"></script>
<script src="{{ 'product-framing-catalog.js' | asset_url }}&psv=large-framing-20260825" defer="defer"></script>
{% if framing_render_mode == 'css' %}
  <script src="{{ 'custom-css-framing.js' | asset_url }}&psv=default-product-toggle-v1-20260819" defer="defer"></script>
{% endif %}
<script src="{{ 'product-framing.js' | asset_url }}&psv=default-product-toggle-v1-20260819" defer="defer"></script>
<script src="{{ 'product-showcase.js' | asset_url }}&psv=featured-media-v1-20260819" defer="defer"></script>
<script src="{{ 'product-sale-badge.js' | asset_url }}&psv=variant-discount-v1-20260825" defer="defer"></script>
<script src="{{ 'product-size-guide.js' | asset_url }}&psv=size-guide-v1-20260821" defer="defer"></script>

{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign image_media = product.media | where: 'media_type', 'image' %}
{% assign preview_media = selected_variant.featured_media | default: product.featured_media | default: image_media.first %}
{% unless preview_media.media_type == 'image' %}
  {% assign preview_media = image_media.first %}
{% endunless %}
{% assign selected_media = preview_media %}

<section class="ps-product ps-section" data-ps-product data-ps-product-id="{{ product.id }}" data-ps-product-context="default" data-ps-framing-render-mode="{{ framing_render_mode }}" data-section-id="{{ section.id }}">
  <div class="ps-shell">
    {% if section.settings.show_breadcrumb %}
      <nav class="ps-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a><span>/</span>
        {% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a><span>/</span>{% endif %}
        <span aria-current="page">{{ product.title }}</span>
      </nav>
    {% endif %}

    <div class="ps-layout">
      <div class="ps-left">
        <div class="ps-media-stage">
          <div class="ps-thumbnail-rail">
            {% if section.settings.show_thumbnail_navigation %}
              <button class="ps-thumbnail-rail__control ps-thumbnail-rail__control--up" type="button" data-ps-thumbnail-scroll="-1" aria-label="Show previous thumbnails"><svg class="ps-action-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 15l6-6 6 6" /></svg></button>
            {% endif %}
            <div class="ps-thumbnails" data-ps-thumbnail-rail aria-label="Product media">
              {% for media in product.media %}
                {% if media.media_type == 'image' %}
                  <button class="ps-thumbnail {% if media.id == selected_media.id or forloop.first and selected_media == blank %}is-active{% endif %}" type="button" data-ps-media data-media-id="{{ media.id }}" data-media-src="{{ media.preview_image | image_url: width: 1800 }}" data-media-srcset="{{ media.preview_image | image_url: width: 640 }} 640w, {{ media.preview_image | image_url: width: 900 }} 900w, {{ media.preview_image | image_url: width: 1200 }} 1200w, {{ media.preview_image | image_url: width: 1600 }} 1600w, {{ media.preview_image | image_url: width: 1800 }} 1800w" data-media-alt="{{ media.alt | default: product.title | escape }}" aria-label="Show image {{ forloop.index }}">
                    {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,140,180', alt: media.alt | default: product.title }}
                  </button>
                {% endif %}
              {% endfor %}
            </div>
            {% if section.settings.show_thumbnail_navigation %}
              <button class="ps-thumbnail-rail__control ps-thumbnail-rail__control--down" type="button" data-ps-thumbnail-scroll="1" aria-label="Show next thumbnails"><svg class="ps-action-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg></button>
            {% endif %}
          </div>
          <div class="ps-main-media">
            <print-preview class="ps-print-preview" data-ps-art-preview data-orientation="portrait" data-media-id="{{ preview_media.id | default: product.media.first.id }}" style="--pdp-aspect: {% if preview_media %}{{ preview_media.preview_image.width }} / {{ preview_media.preview_image.height }}{% else %}800 / 1100{% endif %};">
              <div class="print-preview__inner" data-pdp-print-preview data-pdp-canvas data-ps-preview-canvas>
                <div class="print-preview__bg" aria-hidden="true"></div>
                {% if framing_render_mode == 'css' %}
                  <div class="ps-css-frame" data-ps-css-frame data-has-frame="false">
                    <div class="ps-css-mat" data-ps-css-mat data-has-mat="false">
                      {% render 'css-frame-rails' %}
                      <div class="ps-css-artwork" data-ps-css-artwork>
                        {% render 'product-preview-artwork', preview_media: preview_media, product: product %}
                      </div>
                    </div>
                  </div>
                {% else %}
                  {% render 'product-preview-artwork', preview_media: preview_media, product: product %}
                {% endif %}
                <img class="print-preview__layer print-preview__layer--passepartout" data-ps-framing-layer="passepartout" width="800" height="1100" alt="" hidden aria-hidden="true">
                <img class="print-preview__layer print-preview__layer--frame" data-ps-framing-layer="frame" width="800" height="1100" alt="" hidden aria-hidden="true">
              </div>
            </print-preview>
            <button class="ps-media-navigation ps-media-navigation--previous" type="button" data-ps-media-direction="-1" aria-label="Show previous image"><svg class="ps-action-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6" /></svg></button>
            <button class="ps-media-navigation ps-media-navigation--next" type="button" data-ps-media-direction="1" aria-label="Show next image"><svg class="ps-action-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6" /></svg></button>
          </div>
        </div>
        <div class="ps-details-relocation-anchor" data-ps-details-desktop-anchor aria-hidden="true"></div>
        <div class="ps-left-details" data-ps-accordions>
          <section class="ps-accordion-panel" data-ps-accordion>
            <button class="ps-accordion-panel__trigger" type="button" data-ps-accordion-trigger aria-expanded="false" aria-controls="ps-product-details-{{ section.id }}">
              <span>{{ section.settings.product_details_heading }}</span><span class="ps-accordion-panel__icon" aria-hidden="true">+</span>
            </button>
            <div class="ps-accordion-panel__body" id="ps-product-details-{{ section.id }}" data-ps-accordion-panel aria-hidden="true">
              <div class="ps-accordion-panel__body-inner">
                <div class="ps-detail-content rte">{{ product.description | default: '<p>Made to order with carefully selected materials and designed to bring character to your space.</p>' }}</div>
              </div>
            </div>
          </section>
          <section class="ps-accordion-panel" data-ps-accordion>
            <button class="ps-accordion-panel__trigger" type="button" data-ps-accordion-trigger aria-expanded="false" aria-controls="ps-shipping-returns-{{ section.id }}">
              <span>{{ section.settings.shipping_returns_heading }}</span><span class="ps-accordion-panel__icon" aria-hidden="true">+</span>
            </button>
            <div class="ps-accordion-panel__body" id="ps-shipping-returns-{{ section.id }}" data-ps-accordion-panel aria-hidden="true">
              <div class="ps-accordion-panel__body-inner">
                <div class="ps-detail-content">{{ section.settings.shipping_returns_content }}</div>
              </div>
            </div>
          </section>
        </div>
      </div>

      <aside class="ps-purchase" aria-label="Purchase {{ product.title | escape }}">
        {% form 'product', product, class: 'ps-form', data_ps_form: '' %}
          <input type="hidden" name="id" value="{{ selected_variant.id }}" data-ps-variant-input>
          {% for block in section.blocks %}
            {% render 'product-purchase-block', block: block, product: product, section: section, selected_variant: selected_variant %}
          {% endfor %}
        {% endform %}
        <div class="ps-details-relocation-anchor" data-ps-details-mobile-anchor aria-hidden="true"></div>
      </aside>
    </div>

  </div>

  {% render 'product-size-guide', product: product, section: section %}
</section>

<script type="application/json" data-ps-variants>
  {{ product.variants | json }}
</script>
{% render 'product-framing-catalog', section: section %}

