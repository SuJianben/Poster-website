        { "type": "text", "id": "guide_label", "label": "Size guide label", "default": "Size guide" }
      ]
    },
    {
      "type": "variant_options",
      "name": "Other variant options",
      "limit": 1,
      "settings": []
    },
    {
      "type": "passepartout",
      "name": "Passepartout selector",
      "limit": 1,
      "settings": [
