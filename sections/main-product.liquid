      "name": "Review summary",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Verified reviews" }
      ]
    },
    {
      "type": "title",
      "name": "Product title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "vendor",
      "name": "Artist or vendor",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Artist:" }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "shipping_note",
      "name": "Shipping note",
      "limit": 1,
