{{ 'product-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-showcase.js' | asset_url }}" defer="defer"></script>

{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign selected_media = selected_variant.featured_media | default: product.featured_media %}

<section class="ps-product" data-ps-product data-section-id="{{ section.id }}">
  <div class="ps-shell">
    <nav class="ps-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span>/</span>
      {% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a><span>/</span>{% endif %}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="ps-layout">
      <div class="ps-left">
        <div class="ps-media-stage">
          <div class="ps-thumbnail-rail">
            <button class="ps-thumbnail-rail__control ps-thumbnail-rail__control--up" type="button" data-ps-thumbnail-scroll="-1" aria-label="Show previous thumbnails"><svg class="ps-action-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 15l6-6 6 6" /></svg></button>
            <div class="ps-thumbnails" data-ps-thumbnail-rail aria-label="Product media">
              {% for media in product.media %}
                {% if media.media_type == 'image' %}
                  <button class="ps-thumbnail {% if media.id == selected_media.id or forloop.first and selected_media == blank %}is-active{% endif %}" type="button" data-ps-media data-media-id="{{ media.id }}" data-media-src="{{ media.preview_image | image_url: width: 1800 }}" data-media-alt="{{ media.alt | default: product.title | escape }}" aria-label="Show image {{ forloop.index }}">
                    {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,140,180', alt: media.alt | default: product.title }}
                  </button>
                {% endif %}
              {% endfor %}
            </div>
            <button class="ps-thumbnail-rail__control ps-thumbnail-rail__control--down" type="button" data-ps-thumbnail-scroll="1" aria-label="Show next thumbnails"><svg class="ps-action-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg></button>
          </div>
          <div class="ps-main-media">
            {% if selected_media %}
              <img
                class="ps-main-media__image"
                data-ps-main-image
                src="{{ selected_media.preview_image | image_url: width: 1800 }}"
                srcset="{{ selected_media.preview_image | image_url: width: 640 }} 640w, {{ selected_media.preview_image | image_url: width: 900 }} 900w, {{ selected_media.preview_image | image_url: width: 1200 }} 1200w, {{ selected_media.preview_image | image_url: width: 1600 }} 1600w, {{ selected_media.preview_image | image_url: width: 1800 }} 1800w"
                sizes="(min-width: 901px) 58vw, 100vw"
                width="{{ selected_media.preview_image.width }}"
                height="{{ selected_media.preview_image.height }}"
                loading="eager"
                alt="{{ selected_media.alt | default: product.title | escape }}"
              >
            {% else %}
              <img class="ps-main-media__image" data-ps-main-image src="{{ 'figma-poster-a1.jpg' | asset_url }}" width="1200" height="1500" alt="{{ product.title | escape }}">
            {% endif %}
            <button class="ps-media-navigation ps-media-navigation--previous" type="button" data-ps-media-direction="-1" aria-label="Show previous image"><svg class="ps-action-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6" /></svg></button>
            <button class="ps-media-navigation ps-media-navigation--next" type="button" data-ps-media-direction="1" aria-label="Show next image"><svg class="ps-action-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6" /></svg></button>
          </div>
        </div>
        <div class="ps-details-relocation-anchor" data-ps-details-desktop-anchor aria-hidden="true"></div>
        <div class="ps-left-details" data-ps-accordions>
          <section class="ps-accordion-panel" data-ps-accordion>
            <button class="ps-accordion-panel__trigger" type="button" data-ps-accordion-trigger aria-expanded="false" aria-controls="ps-product-details-{{ section.id }}">
              <span>Product details</span><span class="ps-accordion-panel__icon" aria-hidden="true">+</span>
            </button>
            <div class="ps-accordion-panel__body" id="ps-product-details-{{ section.id }}" data-ps-accordion-panel aria-hidden="true">
              <div class="ps-accordion-panel__body-inner">
                <div class="ps-detail-content rte">{{ product.description | default: '<p>Made to order with carefully selected materials and designed to bring character to your space.</p>' }}</div>
              </div>
            </div>
          </section>
          <section class="ps-accordion-panel" data-ps-accordion>
            <button class="ps-accordion-panel__trigger" type="button" data-ps-accordion-trigger aria-expanded="false" aria-controls="ps-shipping-returns-{{ section.id }}">
              <span>Shipping and returns</span><span class="ps-accordion-panel__icon" aria-hidden="true">+</span>
            </button>
            <div class="ps-accordion-panel__body" id="ps-shipping-returns-{{ section.id }}" data-ps-accordion-panel aria-hidden="true">
              <div class="ps-accordion-panel__body-inner">
                <div class="ps-detail-content"><p>Each order is made for you. Delivery estimates are shown before checkout.</p></div>
              </div>
            </div>
          </section>
        </div>
      </div>

      <aside class="ps-purchase" aria-label="Purchase {{ product.title | escape }}">
        {% if product.compare_at_price_max > product.price %}<span class="ps-sale-badge">Save {{ product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max }}%</span>{% endif %}
        <p class="ps-review-line">★★★★★ <span>Verified reviews</span></p>
        <h1>{{ product.title }}</h1>
        {% if product.vendor != blank %}<p class="ps-vendor">Artist: <strong>{{ product.vendor }}</strong></p>{% endif %}
        <div class="ps-price" data-ps-price>
          <span class="ps-price__current">{{ selected_variant.price | money }}</span>
          <s class="ps-price__compare {% unless selected_variant.compare_at_price > selected_variant.price %}is-hidden{% endunless %}" data-ps-compare>{{ selected_variant.compare_at_price | money }}</s>
        </div>
        <p class="ps-shipping-note">Free shipping on qualifying orders.</p>

        <div class="ps-product-config" aria-label="Product configuration">
          <div class="ps-config-group">
            <p class="ps-config-label">Material: <strong data-ps-choice-output>Canvas</strong></p>
            <div class="ps-config-options" data-ps-choice-group>
              <button type="button" data-ps-choice aria-pressed="false">Poster</button>
              <button type="button" class="is-selected" data-ps-choice aria-pressed="true">Canvas</button>
              <button type="button" data-ps-choice aria-pressed="false">Acrylic</button>
            </div>
          </div>
          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {% assign option_name = option.name | downcase %}
              {% if option_name contains 'size' %}
                <fieldset class="ps-config-group ps-option-group" data-ps-option-group data-option-position="{{ option.position }}" aria-label="{{ option.name | escape }}">
                  <div class="ps-config-label-row"><p class="ps-config-label">Size: <strong data-ps-option-label>{{ option.selected_value }}</strong></p><button type="button" class="ps-size-guide">Size guide</button></div>
                  <div class="ps-config-options ps-config-options--size">
                    {% for value in option.values %}
                      <input id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                      <label for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}">{{ value }}</label>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endif %}
            {% endfor %}
          {% endunless %}
          <div class="ps-config-group">
            <p class="ps-config-label">Premium frame: <strong data-ps-choice-output>No frame</strong></p>
            <div class="ps-frame-options" data-ps-choice-group>
              <button type="button" class="ps-frame-option ps-frame-option--natural is-selected" data-ps-choice data-ps-frame-name="No frame" aria-pressed="true" aria-label="No frame"></button>
              <button type="button" class="ps-frame-option ps-frame-option--white" data-ps-choice data-ps-frame-name="White frame" aria-pressed="false" aria-label="White frame"></button>
              <button type="button" class="ps-frame-option ps-frame-option--black" data-ps-choice data-ps-frame-name="Black frame" aria-pressed="false" aria-label="Black frame"></button>
            </div>
          </div>
          <label class="ps-addon"><input type="checkbox"><span></span>Canvas print hanging kit <small>(+ $5.81)</small></label>
        </div>

        {% form 'product', product, class: 'ps-form', data_ps_form: '' %}
          <input type="hidden" name="id" value="{{ selected_variant.id }}" data-ps-variant-input>
          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {% assign option_name = option.name | downcase %}
              {% unless option_name contains 'size' %}
                <fieldset class="ps-option-group" data-ps-option-group data-option-position="{{ option.position }}">
                  <legend>{{ option.name }}: <span data-ps-option-label>{{ option.selected_value }}</span></legend>
                  <div class="ps-option-values">
                    {% for value in option.values %}
                      <input id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                      <label for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}">{{ value }}</label>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endunless %}
            {% endfor %}
          {% endunless %}

          <div class="ps-form__quantity" data-ps-quantity>
            <label for="Quantity-{{ section.id }}">Quantity</label>
            <div><button type="button" data-ps-quantity-change="-1" aria-label="Decrease quantity">−</button><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1"><button type="button" data-ps-quantity-change="1" aria-label="Increase quantity">+</button></div>
          </div>
          <button class="ps-add-button" type="submit" data-ps-add-button {% unless selected_variant.available %}disabled{% endunless %}>
            <span class="ps-add-button__label" data-ps-add-label>{% if selected_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
          </button>
          <p class="ps-form__status" data-ps-status role="status"></p>
        {% endform %}

        <div class="ps-offer-group">
          <button type="button" class="ps-offer" data-ps-offer-toggle aria-expanded="false"><strong>SUMMER OFFER</strong><span> - BUY3+ Save 15%</span><span class="ps-offer__more">more <svg class="ps-offer__icon" aria-hidden="true" viewBox="0 0 12 8" focusable="false"><path d="M1 1.25 6 6.25 11 1.25"/></svg></span></button>
          <div class="ps-quantity-savings" data-ps-offer-details hidden>
            <div><strong>Buy quantity</strong><strong>Discount</strong></div>
            <div><span>Buy 1</span><span>Standard price</span></div>
            <div><span>Buy 2</span><span>Save 10%</span></div>
            <div><span>Buy 3+</span><span>Save 15%</span></div>
          </div>
        </div>
        <ul class="ps-assurances">
          <li>Immediately ready to hang</li>
          <li>Free worldwide shipping over $49</li>
          <li>Estimated delivery: Jul 29 - Jul 31</li>
        </ul>
        <div class="ps-payment-block">
          <p>Securely packaged &amp; paid</p>
          <div class="ps-payment-badges" aria-label="Accepted payment methods"><span>AMEX</span><span>Apple Pay</span><span>blik</span><span>G Pay</span><span>MC</span><span>PayPal</span><span>VISA</span><span>Klarna</span></div>
          <small>♢ Special packaging for art galleries</small>
        </div>
        <div class="ps-details-relocation-anchor" data-ps-details-mobile-anchor aria-hidden="true"></div>
      </aside>
    </div>

  </div>

  <section class="ps-benefits" aria-label="Shopping benefits">
    <div><strong>Premium quality</strong><span>Made with carefully selected materials.</span></div>
    <div><strong>Satisfied or money back</strong><span>Shop with confidence.</span></div>
    <div><strong>Free shipping</strong><span>On qualifying orders.</span></div>
    <div><strong>30 days return right</strong><span>Easy returns when eligible.</span></div>
  </section>

  <div class="ps-lifestyle">
    {% if section.settings.lifestyle_image %}
      {{ section.settings.lifestyle_image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '750,1200,1600,2200', alt: product.title }}
    {% else %}
      <img src="{{ 'figma-lifestyle-hero.jpg' | asset_url }}" width="2200" height="1240" loading="lazy" alt="{{ product.title | escape }} in a styled interior">
    {% endif %}
  </div>

  <section class="ps-description-shell">
    <div class="ps-description-tabs" role="tablist" aria-label="Product information">
      <button class="is-active" id="ps-description-tab-{{ section.id }}" type="button" role="tab" data-ps-description-tab="description" aria-selected="true" aria-controls="ps-description-panel-{{ section.id }}">Description</button>
      <button id="ps-fair-pricing-tab-{{ section.id }}" type="button" role="tab" data-ps-description-tab="fair-pricing" aria-selected="false" aria-controls="ps-fair-pricing-panel-{{ section.id }}">Fair Pricing</button>
      <button id="ps-artist-tab-{{ section.id }}" type="button" role="tab" data-ps-description-tab="artist" aria-selected="false" aria-controls="ps-artist-panel-{{ section.id }}">Artist Information</button>
      <button id="ps-material-tab-{{ section.id }}" type="button" role="tab" data-ps-description-tab="material" aria-selected="false" aria-controls="ps-material-panel-{{ section.id }}">Material &amp; Workmanship</button>
      <button id="ps-shipping-tab-{{ section.id }}" type="button" role="tab" data-ps-description-tab="shipping" aria-selected="false" aria-controls="ps-shipping-panel-{{ section.id }}">Shipping and Returns</button>
      <button id="ps-security-tab-{{ section.id }}" type="button" role="tab" data-ps-description-tab="security" aria-selected="false" aria-controls="ps-security-panel-{{ section.id }}">Security</button>
    </div>

    <div class="ps-description-panels">
      <div class="ps-description-panel is-active" id="ps-description-panel-{{ section.id }}" role="tabpanel" data-ps-description-panel="description" aria-labelledby="ps-description-tab-{{ section.id }}" tabindex="0">
        <div class="ps-description rte">{{ product.description }}</div>
      </div>
      <div class="ps-description-panel" id="ps-fair-pricing-panel-{{ section.id }}" role="tabpanel" data-ps-description-panel="fair-pricing" aria-labelledby="ps-fair-pricing-tab-{{ section.id }}" hidden tabindex="0">
        <div class="ps-description"><h2>Fair pricing</h2><p>We keep pricing clear and considered, so you can choose a piece you love with confidence. Every order is made with carefully selected materials and prepared with lasting quality in mind.</p></div>
      </div>
      <div class="ps-description-panel" id="ps-artist-panel-{{ section.id }}" role="tabpanel" data-ps-description-panel="artist" aria-labelledby="ps-artist-tab-{{ section.id }}" hidden tabindex="0">
        <div class="ps-description"><h2>Artist information</h2><p>{% if product.vendor != blank %}{{ product.vendor }}{% else %}Our artist collection{% endif %} brings distinctive ideas and character to every piece. Each artwork is selected to give your space a more personal point of view.</p></div>
      </div>
      <div class="ps-description-panel" id="ps-material-panel-{{ section.id }}" role="tabpanel" data-ps-description-panel="material" aria-labelledby="ps-material-tab-{{ section.id }}" hidden tabindex="0">
        <div class="ps-description"><h2>Material &amp; workmanship</h2><p>Made with carefully selected materials, precise printing and thoughtful finishing. Every piece is prepared for a clean presentation and long-lasting everyday enjoyment.</p></div>
      </div>
      <div class="ps-description-panel" id="ps-shipping-panel-{{ section.id }}" role="tabpanel" data-ps-description-panel="shipping" aria-labelledby="ps-shipping-tab-{{ section.id }}" hidden tabindex="0">
        <div class="ps-description"><h2>Shipping and returns</h2><p>Orders are prepared with care and securely packed for delivery. Shipping details are shown before checkout, and eligible returns can be requested within the applicable return period.</p></div>
      </div>
      <div class="ps-description-panel" id="ps-security-panel-{{ section.id }}" role="tabpanel" data-ps-description-panel="security" aria-labelledby="ps-security-tab-{{ section.id }}" hidden tabindex="0">
        <div class="ps-description"><h2>Security</h2><p>Your order is handled through Shopify’s secure checkout. We use protected payment processing and securely packaged delivery so you can shop with confidence.</p></div>
      </div>
    </div>
  </section>
</section>

<script type="application/json" data-ps-variants>
  {{ product.variants | json }}
</script>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "image_picker",
      "id": "lifestyle_image",
      "label": "Lifestyle image below product"
    }
  ]
}
{% endschema %}
