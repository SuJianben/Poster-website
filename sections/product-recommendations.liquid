{%- comment -%} You may also like — Shopify product recommendations, loaded client-side. {%- endcomment -%}
<section class="ps-section ps-recs" data-ps-recs data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <h2 class="ps-recs__heading">{{ section.settings.heading }}</h2>
    <div class="ps-recs__grid">
      {%- for rp in recommendations.products -%}
        <a class="ps-recs__card" href="{{ rp.url }}">
          {%- if rp.featured_image -%}<img src="{{ rp.featured_image | image_url: width: 600 }}" srcset="{{ rp.featured_image | image_url: width: 300 }} 300w, {{ rp.featured_image | image_url: width: 600 }} 600w" sizes="(max-width:767px) 45vw, 22vw" width="600" height="{{ 600 | divided_by: rp.featured_image.aspect_ratio | round }}" alt="{{ rp.featured_image.alt | default: rp.title | escape }}" loading="lazy">{%- endif -%}
          <span class="ps-recs__title">{{ rp.title }}</span>
          <span class="ps-recs__price">From {{ rp.price_min | money }}</span>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
<style>
  .ps-recs{padding:32px 16px 40px;max-width:1200px;margin:0 auto}
  .ps-recs:empty{display:none}
  .ps-recs__heading{font-size:22px;margin:0 0 18px}
  .ps-recs__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
  @media (min-width:768px){.ps-recs__grid{grid-template-columns:repeat(4,1fr);gap:24px}.ps-recs{padding:48px 24px 64px}}
  .ps-recs__card{display:block;text-decoration:none;color:inherit}
  .ps-recs__card img{width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;background:#f3f3f3;display:block;margin-bottom:8px}
  .ps-recs__title{display:block;font-size:14px;line-height:1.35}
  .ps-recs__price{display:block;font-size:13px;color:#666;margin-top:2px}
</style>
<script>(function(){
  var el=document.currentScript.previousElementSibling.previousElementSibling; if(!el||!el.hasAttribute('data-ps-recs')) el=document.querySelector('[data-ps-recs]:not([data-loaded])'); if(!el||el.dataset.loaded) return; el.dataset.loaded='1';
  fetch(el.dataset.url).then(function(r){return r.text();}).then(function(html){ var d=document.createElement('div'); d.innerHTML=html; var inner=d.querySelector('[data-ps-recs]'); if(inner&&inner.innerHTML.trim()){ el.innerHTML=inner.innerHTML; } }).catch(function(){});
})();</script>
{% schema %}
{
  "name": "You may also like",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [ { "name": "You may also like" } ]
}
{% endschema %}