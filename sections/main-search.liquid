{{ 'search-page.css' | asset_url | stylesheet_tag }}

<section class="sp-search">
  <div class="sp-search__shell">
    <form class="sp-search__form" action="{{ routes.search_url }}" method="get" role="search">
      <svg class="sp-search__icon" aria-hidden="true" viewBox="0 0 16 16" focusable="false"><circle cx="6.5" cy="6.5" r="3.5"/><path d="m9.2 9.2 3.2 3.2"/></svg>
      <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off" aria-label="{{ 'search.placeholder' | t }}">
    </form>
    {% if search.performed %}
      {% if search.results_count > 0 %}
        <div class="sp-search__results product-grid">
          {% for item in search.results %}{% if item.object_type == 'product' %}{% render 'poster-card', product: item %}{% endif %}{% endfor %}
        </div>
      {% else %}<p class="sp-search__empty">No products found.</p>{% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{"name":"Main search","settings":[]}
{% endschema %}
