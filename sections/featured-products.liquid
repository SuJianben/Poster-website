{{ 'featured-flow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-flow.js' | asset_url }}" defer="defer"></script>

{% assign selected_collection = section.settings.collection %}

{% if selected_collection != blank and selected_collection.products_count > 0 %}
{% assign first_product = selected_collection.products[3] | default: selected_collection.products.first %}
<section class="tilted-carousel" data-tilted-carousel data-tilted-collection-link="{% if selected_collection != blank %}{{ selected_collection.url }}{% endif %}" aria-label="Image carousel">
  <div class="tilted-carousel__app">
    <header class="tilted-carousel__heading">
      <p>Featured this week</p>
      <h2>Handpicked drops.</h2>
    </header>
    <div class="tilted-carousel__viewport" data-tilted-viewport>
      <div class="tilted-carousel__track" data-tilted-track>
      {% if selected_collection != blank and selected_collection.products_count > 0 %}
        {% for product in selected_collection.products limit: section.settings.max_products %}
          {% capture product_meta %}{% if product.vendor != blank %}{{ product.vendor }} · {% endif %}{{ product.price | money }}{% endcapture %}
          <article class="tilted-carousel__slide" data-tilted-slide data-title="{{ product.title | escape }}" data-meta="{{ product_meta | strip | escape }}" data-link="{{ product.url }}" data-source="collection" aria-current="false">
            <button class="tilted-carousel__image" type="button" data-tilted-select aria-label="Show {{ product.title | escape }}">
              {% if product.featured_media %}
                {{ product.featured_media | image_url: width: 900 | image_tag: alt: product.title, widths: '320,480,640,900', loading: 'lazy' }}
              {% endif %}
            </button>
          </article>
        {% endfor %}
      {% endif %}
      </div>
    </div>
    <div class="tilted-carousel__product" data-tilted-product>
      <h3 data-tilted-title>{{ first_product.title }}</h3>
      <p data-tilted-meta>{% if first_product.vendor != blank %}{{ first_product.vendor }} · {% endif %}{{ first_product.price | money }}</p>
      <a class="tilted-carousel__link" data-tilted-link href="{{ first_product.url }}">View poster <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="tilted-carousel__controls" aria-label="Carousel controls">
    <button class="tilted-carousel__arrow" type="button" data-tilted-previous aria-label="Previous image"><span aria-hidden="true">‹</span></button>
    <div class="tilted-carousel__dots" data-tilted-dots>
      {% if selected_collection != blank and selected_collection.products_count > 0 %}
        {% for product in selected_collection.products limit: section.settings.max_products %}
          <button type="button" class="tilted-carousel__dot" data-tilted-dot aria-label="Show image {{ forloop.index }}"></button>
        {% endfor %}
      {% endif %}
    </div>
    <button class="tilted-carousel__arrow" type="button" data-tilted-next aria-label="Next image"><span aria-hidden="true">›</span></button>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name":"Tilted carousel",
  "settings":[
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"max_products","label":"Products to show","min":3,"max":12,"step":1,"default":10}
  ]
}
{% endschema %}
