{{ 'featured-flow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-flow.js' | asset_url }}" defer="defer"></script>

{% assign tilted_titles = 'Paper Bird|Midnight Transit|Wild Bloom|Fuji Street|Bicycle Stories|Northbound|Track Lines|Lawson Glow|City Motion|Quiet Ritual' | split: '|' %}
{% assign tilted_meta = 'Fons Heijnsbroek · A2 · $199|Mira Cole · A2 · $179|Noah Fields · A2 · $169|Aiko Tanaka · A2 · $189|Riku Studio · A2 · $179|Sora Kim · A2 · $159|Yuki Ito · A2 · $169|Nami Okada · A2 · $189|Kaito Mori · A2 · $179|Hana Watanabe · A2 · $199' | split: '|' %}
{% assign tilted_assets = 'reference-tilted-01.jpg|reference-tilted-02.jpg|reference-tilted-03.jpg|reference-tilted-04.jpg|reference-tilted-05.jpg|reference-tilted-06.jpg|reference-tilted-07.jpg|reference-tilted-08.jpg|reference-tilted-09.jpg|reference-tilted-10.jpg' | split: '|' %}
{% assign selected_collection = section.settings.collection %}

<section class="tilted-carousel" data-tilted-carousel data-tilted-collection-link="{% if selected_collection != blank %}{{ selected_collection.url }}{% endif %}" aria-label="Image carousel">
  <div class="tilted-carousel__app">
    <header class="tilted-carousel__heading">
      <p>Featured this week</p>
      <h2>Handpicked drops.</h2>
    </header>
    <div class="tilted-carousel__viewport" data-tilted-viewport>
      <div class="tilted-carousel__track" data-tilted-track>
      {% if selected_collection != blank and selected_collection.products_count > 0 %}
        {% for product in selected_collection.products limit: section.settings.max_products %}
          {% assign product_artist = product.metafields.custom.artist.value | default: product.metafields.custom.artist | default: product.type | default: product.vendor %}
          {% assign hover_media = blank %}
          {% if product.media.size > 1 and product.media[1].media_type == 'image' %}
            {% assign hover_media = product.media[1] %}
          {% endif %}
          <article class="tilted-carousel__slide{% if hover_media != blank %} has-hover-image{% endif %}" data-tilted-slide data-product-handle="{{ product.handle | escape }}" data-link="{{ product.url }}" data-source="collection" aria-current="false">
            <a class="tilted-carousel__image" href="{{ product.url }}" data-tilted-select aria-label="View {{ product.title | escape }}">
              {% if product.featured_media %}
                {{ product.featured_media | image_url: width: 900 | image_tag: class: 'tilted-carousel__primary-image', alt: product.title, widths: '320,480,640,900', loading: 'lazy' }}
              {% endif %}
              {% if hover_media != blank %}
                {{ hover_media | image_url: width: 900 | image_tag: class: 'tilted-carousel__hover-image', alt: product.title, widths: '320,480,640,900', loading: 'lazy' }}
              {% endif %}
            </a>
            <div class="tilted-carousel__details">
              {% if product_artist != blank %}<p class="tilted-carousel__artist">{{ product_artist }}</p>{% endif %}
              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="tilted-carousel__price">
                <span>From {{ product.price_min | money }}</span>
                {% if product.compare_at_price_max > product.price_min %}<s>{{ product.compare_at_price_max | money }}</s>{% endif %}
              </p>
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for asset_name in tilted_assets %}
          {% assign title = tilted_titles[forloop.index0] %}
          {% assign meta = tilted_meta[forloop.index0] %}
          <article class="tilted-carousel__slide" data-tilted-slide data-product-handle="mock-{{ forloop.index }}" data-link="#" data-source="mock" aria-current="false">
            <a class="tilted-carousel__image" href="#" data-tilted-select aria-label="View {{ title | escape }}">
              <img class="tilted-carousel__primary-image" src="{{ asset_name | asset_url }}" alt="{{ title | escape }}" width="500" height="667"{% unless forloop.index0 == 3 %} loading="lazy"{% endunless %}>
            </a>
            <div class="tilted-carousel__details">
              <p class="tilted-carousel__artist">PosterAndForm</p>
              <h3><a href="#">{{ title }}</a></h3>
              <p class="tilted-carousel__price"><span>{{ meta }}</span></p>
            </div>
          </article>
        {% endfor %}
      {% endif %}
      </div>
    </div>
  </div>

  <div class="tilted-carousel__controls" aria-label="Carousel controls">
    <button class="tilted-carousel__arrow" type="button" data-tilted-previous aria-label="Previous image"><span aria-hidden="true">‹</span></button>
    <div class="tilted-carousel__dots" data-tilted-dots>
      {% if selected_collection != blank and selected_collection.products_count > 0 %}
        {% for product in selected_collection.products limit: section.settings.max_products %}
          <button type="button" class="tilted-carousel__dot" data-tilted-dot aria-label="Show image {{ forloop.index }}"></button>
        {% endfor %}
      {% else %}
        {% for asset_name in tilted_assets %}
          <button type="button" class="tilted-carousel__dot" data-tilted-dot aria-label="Show image {{ forloop.index }}"></button>
        {% endfor %}
      {% endif %}
    </div>
    <button class="tilted-carousel__arrow" type="button" data-tilted-next aria-label="Next image"><span aria-hidden="true">›</span></button>
  </div>
</section>

{% schema %}
{
  "name":"Tilted carousel",
  "settings":[
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"max_products","label":"Products to show","min":3,"max":12,"step":1,"default":10}
  ]
}
{% endschema %}

