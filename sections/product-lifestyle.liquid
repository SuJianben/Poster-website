{{ 'product-showcase.css' | asset_url | stylesheet_tag }}

<div class="ps-lifestyle ps-section">
  {% if section.settings.image %}
    {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '750,1200,1600,2200', alt: product.title }}
  {% else %}
    <img src="{{ 'figma-lifestyle-hero.jpg' | asset_url }}" width="2200" height="1240" loading="lazy" alt="{{ product.title | escape }} in a styled interior">
  {% endif %}
</div>

{% schema %}
{
  "name": "Product lifestyle image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    }
  ],
  "presets": [
    {
      "name": "Product lifestyle image"
    }
  ]
}
{% endschema %}
