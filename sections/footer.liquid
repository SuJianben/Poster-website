<footer class="site-footer">
  <div class="page-width">
    {% if section.settings.show_newsletter %}
      <div class="newsletter">
        <h2>{{ section.settings.newsletter_heading }}</h2>
        <p>{{ section.settings.newsletter_text }}</p>
        {% assign newsletter_form_id = 'FooterNewsletter-' | append: section.id %}
        {% form 'customer', id: newsletter_form_id, class: 'newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {% if form.posted_successfully? %}
            <p class="newsletter__message newsletter__message--success" role="status" tabindex="-1" autofocus>
              {{ 'newsletter.success' | t }}
            </p>
          {% else %}
            {% if form.errors %}
              <div class="newsletter__message newsletter__message--error" id="FooterNewsletterError-{{ section.id }}" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <label class="visually-hidden" for="FooterNewsletterEmail-{{ section.id }}">
              {{ 'newsletter.email_label' | t }}
            </label>
            <input
              id="FooterNewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              placeholder="{{ 'general.email_placeholder' | t }}"
              {% if form.errors %}aria-invalid="true" aria-describedby="FooterNewsletterError-{{ section.id }}"{% endif %}
            >
            <button class="button" type="submit">{{ 'general.subscribe' | t }}</button>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="footer-links">
        {% for block in section.blocks %}
          <div {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h3>{{ block.settings.heading | escape }}</h3>
            {% endif %}

            {% if block.settings.menu != blank %}
              {% for link in block.settings.menu.links %}
                <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {% endfor %}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
      {% if section.settings.bottom_text != blank %}<span>{{ section.settings.bottom_text | escape }}</span>{% endif %}
    </div>
  </div>
</footer>
{% schema %}{"name":"Footer","settings":[{"type":"checkbox","id":"show_newsletter","label":"Show newsletter","default":true},{"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"Newsletter"},{"type":"text","id":"newsletter_text","label":"Newsletter text","default":"Get 10% off your first order."},{"type":"text","id":"bottom_text","label":"Bottom text","default":"Curated art prints for considered spaces."}],"blocks":[{"type":"link_column","name":"Link column","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop"},{"type":"link_list","id":"menu","label":"Menu"}]}],"max_blocks":4}{% endschema %}


